<?xml version="1.0" encoding="UTF-8"?>
<Specification>
	<Headline name="RGB-Controller" type="dp-decoder" version="1.0" owner="theosoft"/>
	<Enums>
		<Enum name="OperationMode">
			<Value name="white" value="0"/>
			<Value name="color" value="1"/>
			<Value name="scene" value="2"/>
			<Value name="music" value="3"/>
		</Enum>
		<Enum name="LightingMode2">
			<Value name="Jumping" value="0"/>
			<Value name="Gradient" value="1"/>
		</Enum>
		<Enum name="LightingMode3">
			<Value name="Static" value="0"/>
			<Value name="Jumping" value="1"/>
			<Value name="Gradient" value="2"/>
		</Enum>
		<Enum name="PowerOffMemoryMode">
			<Value name="initial mode" value="0"/>
			<Value name="last state" value="1"/>
			<Value name="custom mode" value="2"/>
		</Enum>
		<Enum name="DNDMode">
			<Value name="turn off light" value="0"/>
			<Value name="turn on light" value="1"/>
		</Enum>
	</Enums>
	<Datapoints>
